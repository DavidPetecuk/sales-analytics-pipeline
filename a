   "metadata": {},
   "source": [
    "- ordnet pandas es nur anhand der Position zu.\n",
    "\n",
    "- Sicherer bei einem separat berechneten Ergebnis:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "964c2488",
